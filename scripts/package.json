{
  "name": "@synara/scripts",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "node ../node_modules/@typescript/native/bin/tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript-native.tsbuildinfo && bun run typecheck:computer-measurement && bun run typecheck:managed-plugin-smoke",
    "typecheck:computer-measurement": "node ../node_modules/@typescript/native/bin/tsc --project tsconfig.computer-measurement.json",
    "typecheck:managed-plugin-smoke": "node ../node_modules/@typescript/native/bin/tsc --project tsconfig.managed-plugin-smoke.json",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "generate:moss-plugin-database-evidence-schema": "bun run generate-moss-plugin-database-evidence-schema.ts",
    "check:moss-plugin-database-evidence-schema": "bun run generate-moss-plugin-database-evidence-schema.ts --check",
    "claude-fast-mode-probe": "bun run claude-fast-mode-probe.ts",
    "claude-haiku-thinking-probe": "bun run claude-haiku-thinking-probe.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@effect/platform-node": "catalog:",
    "@electron/asar": "3.4.1",
    "@synara/contracts": "workspace:*",
    "@synara/shared": "workspace:*",
    "effect": "catalog:",
    "entities": "6.0.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/bun": "catalog:",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
