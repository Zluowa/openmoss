{
  "name": "@synara/monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "effect": "https://pkg.pr.new/Effect-TS/effect-smol/effect@8881a9b",
      "@effect/platform-node": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node@8881a9b",
      "@effect/openapi-generator": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/openapi-generator@8881a9b",
      "@effect/sql-sqlite-bun": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/sql-sqlite-bun@8881a9b",
      "@effect/vitest": "https://pkg.pr.new/Effect-TS/effect-smol/@effect/vitest@8881a9b",
      "@effect/language-service": "0.75.1",
      "@types/bun": "^1.4.1",
      "@types/node": "^24.10.13",
      "tsdown": "^0.20.3",
      "typescript": "^5.7.3",
      "vitest": "4.1.10"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "moss:dev": "bun --env-file=.env scripts/dev-runner.ts dev:desktop --no-browser",
    "moss:startup-smoke": "bun --env-file=.env scripts/moss-startup-smoke.ts",
    "electron": "bun run start:desktop",
    "electron:dev": "node scripts/dev-runner.ts dev:desktop --home-dir ./.moss/electron-dev",
    "start": "turbo run start --filter=@synara/cli",
    "start:desktop": "turbo run start --filter=@synara/desktop",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@synara/desktop --filter=@synara/cli",
    "postinstall": "node scripts/patch-effect-language-service.ts && effect-tsgo patch --typescript --typescript-package @typescript/native",
    "typecheck": "effect-tsgo patch --typescript --typescript-package @typescript/native && turbo run typecheck",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "turbo run typecheck:legacy",
    "lint": "oxlint --report-unused-disable-directives && bun run server-sync-fs:check && bun run brand:check",
    "server-sync-fs:check": "node scripts/check-server-sync-fs.ts",
    "test": "turbo run test --concurrency=1",
    "test:compiler": "bun run --cwd apps/web test:compiler",
    "test:all": "bun run test && bun run test:compiler",
    "test:web:focused": "bun run --cwd apps/web test",
    "brand:check": "node scripts/check-brand-identity.ts",
    "windows-runtime:check": "node scripts/check-windows-runtime-boundary.ts",
    "migrations:check": "node scripts/check-migration-lineage.ts",
    "security:keychain-policy": "bun scripts/check-keychain-command-policy.ts",
    "test:desktop-smoke": "turbo run smoke-test --filter=@synara/desktop",
    "test:device": "bun scripts/device-helper-smoke.ts",
    "test:device:probe": "bun scripts/device-helper-smoke.ts --probe-only",
    "test:device:sweep": "bun scripts/device-helper-sweep.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:inline-visualization-libs": "bun scripts/build-inline-visualization-libraries.ts",
    "build:contracts": "turbo run build --filter=@synara/contracts",
    "dist:desktop:artifact": "node scripts/build-desktop-artifact.ts",
    "dist:desktop:dmg": "node scripts/build-desktop-artifact.ts --platform mac --target dmg",
    "dist:desktop:dmg:arm64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64",
    "dist:desktop:dmg:x64": "node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch x64",
    "dist:desktop:linux": "node scripts/build-desktop-artifact.ts --platform linux --target AppImage --arch x64",
    "dist:desktop:win": "node scripts/build-desktop-artifact.ts --platform win --target nsis --arch x64",
    "release:smoke": "node scripts/release-smoke.ts",
    "release:smoke:mac-update": "node scripts/smoke-mac-update-artifact.ts",
    "release:smoke:mac-installed": "node scripts/smoke-mac-installed-app.ts",
    "moss:status": "node scripts/moss-loop-status.ts",
    "moss:prd-coverage": "node scripts/moss-prd-coverage.ts",
    "moss:gui-parity": "node scripts/moss-gui-parity.ts",
    "moss:final-shell-parity": "node scripts/moss-final-shell-parity.ts",
    "moss:bootstrap": "bun scripts/moss-bootstrap.ts",
    "moss:materialize": "bun scripts/moss-materialize.ts",
    "moss:hooks": "bun scripts/moss-hooks.ts",
    "moss:project": "bun run scripts/moss-config-projection.ts",
    "moss:provider-replay": "bun apps/server/src/provider/mossProviderReplay.ts",
    "moss:iteration-packet": "node scripts/moss-iteration-packet.ts",
    "moss:review-packet": "node scripts/moss-review-packet.ts",
    "moss:memory-packet": "node scripts/moss-memory-packet.ts",
    "moss:loop-packet": "node scripts/moss-loop-packet.ts",
    "moss:loop-packet-freshness-refresh-artifact": "node scripts/moss-loop-packet.ts --report --output .moss/ledger/evidence/moss-loop-packet-freshness-gate-report-2026-07-02-refresh.json",
    "moss:loop-packet-freshness-report-index": "node scripts/moss-loop-packet-freshness-report-index.ts",
    "moss:loop-packet-refresh-plan-report-artifact": "node scripts/moss-loop-packet.ts --refresh-plan-report --output .moss/ledger/evidence/moss-loop-packet-refresh-plan-gate-report-2026-07-02.json",
    "moss:loop-packet-refresh-plan-report-index": "node scripts/moss-loop-packet-refresh-plan-report-index.ts",
    "moss:loop-ledger-snapshot": "node scripts/moss-loop-ledger-snapshot.ts",
    "moss:ui-smoke": "node scripts/moss-ui-smoke.ts",
    "moss:electron-product-shell-smoke": "node apps/desktop/scripts/moss-product-shell-smoke.mjs",
    "moss:electron-product-shell-smoke-gate": "node scripts/moss-electron-product-shell-smoke-gate.ts",
    "moss:right-controls-smoke": "node apps/desktop/scripts/moss-right-controls-smoke.mjs",
    "moss:right-controls-smoke-gate": "node scripts/moss-right-controls-smoke-gate.ts",
    "moss:provider-discovery-smoke": "bun scripts/moss-provider-discovery-smoke.ts",
    "moss:provider-discovery-smoke-gate": "bun scripts/moss-provider-discovery-smoke-gate.ts",
    "moss:production-provider-readiness": "bun scripts/moss-production-provider-readiness.ts",
    "moss:production-provider-readiness-gate": "bun scripts/moss-production-provider-readiness-gate.ts",
    "moss:release-gate": "node scripts/moss-release-gate.ts",
    "moss:release-gate-refresh-artifact": "node scripts/moss-release-gate.ts --report --refresh-artifact --output .moss/ledger/evidence/moss-release-gate-report-artifact-2026-07-02-refresh.json",
    "moss:release-freshness-refresh-plan": "node scripts/moss-release-freshness-refresh-plan.ts",
    "moss:release-freshness-refresh-plan-report-artifact": "node scripts/moss-release-freshness-refresh-plan.ts --report --output .moss/ledger/evidence/moss-release-freshness-refresh-plan-report-2026-07-02.json",
    "moss:release-freshness-refresh-plan-report-index": "node scripts/moss-release-freshness-refresh-plan-report-index.ts",
    "moss:release-gate-report-index": "node scripts/moss-release-gate-report-index.ts",
    "canary:setup": "node scripts/canary.ts setup",
    "canary:update": "node scripts/canary.ts update",
    "canary:start": "node scripts/canary.ts start",
    "canary:stop": "node scripts/canary.ts stop",
    "canary:status": "node scripts/canary.ts status",
    "canary:rollback": "node scripts/canary.ts rollback",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules scripts/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .turbo apps/*/.turbo packages/*/.turbo"
  },
  "devDependencies": {
    "@effect/tsgo": "0.41.0",
    "@electric-sql/pglite": "0.3.10",
    "@electron/rebuild": "4.2.0",
    "@types/node": "catalog:",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "electron-builder": "26.8.1",
    "oxfmt": "^0.40.0",
    "oxlint": "^1.55.0",
    "playwright": "^1.58.2",
    "turbo": "^2.9.14",
    "vitest": "catalog:"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent>undici": "^8.12.3",
    "@effect/platform-node-shared>effect": "catalog:",
    "@effect/platform-node>effect": "catalog:",
    "@effect/sql-sqlite-bun>effect": "catalog:",
    "@effect/vitest>effect": "catalog:",
    "axios": "^1.16.0",
    "defu": "^6.1.5",
    "effect>toml": "^5.0.1",
    "fast-uri": "^3.1.2",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.6",
    "hono": "^4.12.25",
    "ip-address": "^10.2.0",
    "joi": "^18.2.1",
    "lodash": "^4.18.1",
    "miniflare>sharp": "^0.35.5",
    "miniflare>undici": "^7.30.1",
    "postcss": "^8.5.10",
    "protobufjs": "^7.6.3",
    "qs": "^6.15.2",
    "seroval": "^1.6.11",
    "smol-toml": "^1.6.1",
    "tinypool": "^2.2.0",
    "uuid": "^13.0.1",
    "vite": "^8.1.4",
    "ws": "^8.21.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "bun": "^1.4.4",
    "node": "^24.13.1"
  },
  "packageManager": "bun@1.4.4",
  "msw": {
    "workerDirectory": [
      "apps/web/public"
    ]
  },
  "patchedDependencies": {
    "@effect/platform-node-shared@https://pkg.pr.new/Effect-TS/effect-smol/@effect/platform-node-shared@8881a9b606d84a6f5eb6615279138322984f5368": "patches/@effect%2Fplatform-node-shared@8881a9b.patch",
    "@legendapp/list@3.3.3": "patches/@legendapp%2Flist@3.3.3.patch",
    "@pierre/diffs@1.3.5": "patches/@pierre%2Fdiffs@1.3.5.patch",
    "betterwright@2.7.3": "patches/betterwright@2.7.3.patch",
    "@vitest/utils@4.1.10": "patches/@vitest+utils@4.1.10.patch",
    "@vitest/browser@4.1.10": "patches/@vitest+browser@4.1.10.patch"
  }
}
