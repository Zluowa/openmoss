{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // The web bundle compiles its workspace dependencies from source (their `import`
      // exports), so it does not wait for their build output. `transit` has no script: it
      // only carries their source hashes into this task's cache key (upstream Synara #2183).
      "dependsOn": ["^transit"],
      // VITE_* reaches this task through Turbo's framework inference. The source-map
      // upload settings do not, and only this package should see the upload token.
      "env": [
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE",
        "MOSS_WEB_PRECOMPRESS_BROTLI_QUALITY",
        "MOSS_WEB_PRECOMPRESS_GZIP_LEVEL",
      ],
      // MOSS_WEB_PRECOMPRESS_CACHE and MOSS_WEB_TRANSFORM_CACHE (desktop fast refresh) change how
      // fast, never what, is built.
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN",
        "MOSS_WEB_PRECOMPRESS_CACHE",
        "MOSS_WEB_PRECOMPRESS_CONCURRENCY",
        "MOSS_WEB_TRANSFORM_CACHE",
      ],
    },
    "dev": {
      "persistent": true,
    },
  },
}
