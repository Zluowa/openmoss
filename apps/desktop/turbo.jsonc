{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/server/src/persistence/Migrations.ts"],
      "outputs": ["dist-electron/**"],
    },
    "dev": {
      "dependsOn": ["@synara/cli#build"],
      "passThroughEnv": [
        "MOSS_MODEL_GATEWAY_API_KEY",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "all_proxy",
        "no_proxy",
      ],
      "persistent": true,
    },
    "start": {
      "dependsOn": ["build", "@synara/web#build", "@synara/cli#build"],
      "cache": false,
      "persistent": true,
    },
    "smoke-test": {
      "dependsOn": ["build", "@synara/web#build", "@synara/cli#build"],
      "cache": false,
      "outputs": [],
    },
  },
}
