{
  "name": "@moss/cli",
  "version": "1.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zluowa/moss-synara.git",
    "directory": "apps/server"
  },
  "bin": {
    "moss": "dist/index.mjs",
    "moss-restore-migration-backup": "dist/restoreMigrationBackup.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "node scripts/cli.ts build",
    "start": "node dist/index.mjs",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit --tsBuildInfoFile node_modules/.cache/typescript-native.tsbuildinfo",
    "typecheck:native": "bun run typecheck",
    "typecheck:legacy": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.2.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "@anthropic-ai/sdk": "^0.100.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@opencode-ai/sdk": "1.18.31",
    "@opencode/client": "2.0.25",
    "@pierre/diffs": "^1.3.5",
    "@sentry/node": "10.73.0",
    "@slate-yjs/core": "1.0.2",
    "@xterm/headless": "^6.0.0",
    "effect": "catalog:",
    "https-proxy-agent": "^7.0.6",
    "lib0": "0.2.119",
    "node-pty": "^1.1.0",
    "open": "^10.1.0",
    "playwright": "^1.58.2",
    "slate": "0.124.1",
    "smol-toml": "^1.7.0",
    "ws": "^8.21.0",
    "y-protocols": "1.0.7",
    "yaml": "^2.8.3",
    "yjs": "13.6.33",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@moss/contracts": "workspace:*",
    "@moss/shared": "workspace:*",
    "@moss/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.5.13",
    "oxfmt": "0.40.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.1.4",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19 || ^23.11 || >=24.10"
  }
}
