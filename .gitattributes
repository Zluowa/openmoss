bun.lock text eol=lf

# Generated third-party license texts and sources are stored byte-for-byte; their upstream
# whitespace and line endings are covered by the compliance hashes (bun run bump:codex).
third_party/openai-codex/** -text -whitespace
scripts/lib/runtime-bump/spdx-texts/** -text -whitespace
scripts/lib/runtime-bump/reviewed-notices/*.md -text -whitespace
scripts/lib/runtime-bump/reviewed-notices/*.txt -text -whitespace

# Patches are applied to upstream sources byte for byte, and the Cua ones are pinned by SHA-256
# (packages/shared/src/cuaDriverRelease.json). A CRLF checkout (core.autocrlf=true, the default
# on Windows runners) would rewrite their line endings and break the pin.
*.patch -text
*.diff -text
